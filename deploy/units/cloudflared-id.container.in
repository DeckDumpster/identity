[Unit]
Description=cloudflared tunnel for id.gantt.pub
After=pocket-id.service
Wants=pocket-id.service

[Container]
ContainerName=cloudflared-id
Image=@CLOUDFLARED_IMAGE@
AutoUpdate=none
# Host network so the tunnel reaches Pocket ID on 127.0.0.1:@PORT@.
Network=host
# TUNNEL_TOKEN lives here (0600, placed by hand, never in git).
EnvironmentFile=@CONFIG_DIR@/cloudflared-id.env
Exec=tunnel --no-autoupdate run

[Service]
Restart=always

[Install]
WantedBy=default.target
